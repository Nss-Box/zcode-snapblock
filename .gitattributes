# Shell scripts must stay LF (break on CRLF when run on Linux/macOS)
*.sh text eol=lf
linux/systemd/* text eol=lf

# Windows-native files keep CRLF
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Everything else: normal text normalization
*.py text
*.md text
*.json text
.gitignore text
*.in text
